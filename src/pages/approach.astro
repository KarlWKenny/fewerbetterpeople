---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPublished, byOrder } from '../lib/content';

const principles = await Promise.all(
  (await getPublished('principles')).sort(byOrder).map(async (p) => {
    const { Content } = await render(p);
    return { data: p.data, Content };
  }),
);
---

<Base
  title="Approach"
  description="The operating model: sharp roles, a working cadence, scorecards the owner can read, and a management team built to decide without him."
>
  <section class="section">
    <div class="wrap">
      <p class="mono-label">Approach</p>
      <h1>The method is not a secret. Doing it is the job.</h1>
      <div class="prose intro">
        <p>
          I subscribe to the belief that everyone wants to do a good job, and
          it is the responsibility of leadership to ensure the company is
          organized to enable everyone to do a good job. Delivering the right
          combination and balance of People, Process and Tools implemented at
          a pace the organization can absorb is the job.
        </p>
      </div>

      <h2>The tenets</h2>
      <ol class="principles">
        {
          principles.map(({ data, Content }) => (
            <li>
              <span class="principle-no" aria-hidden="true">
                {String(data.number).padStart(2, '0')}
              </span>
              <div>
                <h3>{data.title}</h3>
                <div class="prose">
                  <Content />
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-m);
    max-width: 22ch;
  }

  .intro {
    margin-bottom: var(--space-xl);
  }

  h2 {
    margin-bottom: var(--space-m);
  }

  .principles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-l);
  }

  .principles li {
    display: flex;
    gap: var(--space-m);
    max-width: var(--measure);
  }

  .principle-no {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--brass-ink);
    line-height: var(--leading-heading);
  }

  .principles h3 {
    margin-bottom: var(--space-2xs);
  }
</style>
