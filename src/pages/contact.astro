---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact"
  description="Start a conversation with Karl Kenny — an hour, no cost, no deck."
>
  <section class="section">
    <div class="wrap">
      <p class="mono-label">Contact</p>
      <h1>Start with a conversation.</h1>
      <div class="prose">
        <p>
          An hour on the phone or at your plant. You talk about the company;
          I'll tell you honestly whether I can help, and what I would do first.
          If the answer is no, I'll say so and, where I can, point you at
          someone better suited.
        </p>
        <p>
          <!-- A contact form comes later via a Pages Function in /functions —
               see functions/README.md. TODO: add phone number if wanted. -->
          Email:
          <a href="mailto:Karl@FBPeople.com">Karl@FBPeople.com</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-m);
  }
</style>
