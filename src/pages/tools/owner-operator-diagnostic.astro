---
// Proof-of-concept for the /tools/<slug> namespace: static page + one island
// hydrated with client:visible. Hidden from nav and search until built.
import Base from '../../layouts/Base.astro';
import OwnerOperatorDiagnostic from '../../components/islands/OwnerOperatorDiagnostic.tsx';
---

<Base
  title="Owner vs. operator diagnostic"
  description="Score how much of your business still routes through you."
  noindex
>
  <section class="section">
    <div class="wrap">
      <p class="mono-label">Tools</p>
      <h1>Owner vs. operator.</h1>
      <p>
        A short diagnostic that scores how much of the business still routes
        through you. In progress — not yet live.
      </p>
      <OwnerOperatorDiagnostic client:visible />
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-m);
  }
</style>
